# Copy to .env (git-ignored) and fill in. Read by docker-compose.yml.

# Signs the login session cookie. Any long random string; keep it stable so restarts don't log players out.
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The auth Worker (auth-worker/). Local dev: wrangler dev on the host.
AUTH_API_URL=http://host.docker.internal:8787
# Same value as the Worker's AUTH_API_KEY secret (auth-worker/.dev.vars locally).
AUTH_API_KEY=

# Turnstile widget sitekey (public). 1x00000000000000000000AA is Cloudflare's always-pass test key.
TURNSTILE_SITEKEY=1x00000000000000000000AA
